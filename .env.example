# Copy to .env and fill in. Never commit .env.

# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Use a fast, cheap model for high-volume triage (5,000 alerts/day).
# Check current model IDs: https://docs.claude.com/en/docs/about-claude/models
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=500

# --- Storage ---
DB_PATH=data/triage.db

# --- Triage engine API (n8n calls this) ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Decision thresholds (from brief, Phase 3) ---
AUTO_DISMISS_MIN_CONFIDENCE=0.80   # FP with >= 80% confidence -> auto-dismiss
REVIEW_MIN_CONFIDENCE=0.70         # Genuine risk with >= 70% -> analyst review
                                   # Anything else -> senior analyst escalation

# --- Business case inputs (Phase 4 reporting) ---
MANUAL_REVIEW_MINUTES=30
ASSISTED_REVIEW_MINUTES=5
ANALYST_ANNUAL_COST_USD=150000

# --- Triage mode ---
# rules  = free practice mode (no API calls)
# claude = real AI triage (needs ANTHROPIC_API_KEY)
# Leave empty to auto-pick: claude if a real key is set, otherwise rules.
TRIAGE_MODE=
